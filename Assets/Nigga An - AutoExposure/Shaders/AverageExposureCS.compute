#pragma kernel SCAN KERNEL_SCAN

// 32x32 = 1024 threads per group (max allowed on most hardware)
#define THREAD_COUNT 32
#define GROUP_SIZE (THREAD_COUNT * THREAD_COUNT)

// Pixels below this luminance are considered "black" and excluded from the average.
// Avoids dark letterboxes / skyboxes dragging exposure up unnecessarily.
#define MIN_LUM 0.005f

// I/O
uint2 _Dims;                            // Screen Dimensions
uint _NumGroupsX;                       // Number of thread groups along X, needed to linearize group id into the output buffer
float _BrightnessLimit;                 // Max luminance a pixel may contribute — mirrors _MaxBrightness in the render shader.
                                        // Prevents specular highlights, sun discs, and emissive surfaces from skewing
                                        // the geometric mean and causing the scene to underexpose.
Texture2D _Source;                      // Screen Texture
RWStructuredBuffer<float> _OutBuffer;   // Compute Group Output

// Shared per-pixel values, one slot per thread in the group
groupshared float shared_lum[GROUP_SIZE];
groupshared uint shared_pixels[GROUP_SIZE];

// Convert screen coordinates to the pixel's luminosity (BT.709 coefficients)
float get_screen_lum(uint x, uint y) {
    return dot(_Source[uint2(x, y)].rgb, float3(0.21267291f, 0.7151522f, 0.0721750f));
}

// Each thread now corresponds to a single pixel (x, y) instead of a whole row
[numthreads(THREAD_COUNT, THREAD_COUNT, 1)]
void SCAN(uint3 groupId : SV_GroupID, uint3 threadId : SV_GroupThreadID, uint3 dispatchId : SV_DispatchThreadID) {
    uint x = dispatchId.x;
    uint y = dispatchId.y;
    uint index = threadId.y * THREAD_COUNT + threadId.x;

    // Fetch this thread's single pixel; exclude out-of-bounds and near-black pixels.
    // Near-black exclusion prevents large dark regions (skybox, letterbox, unlit areas)
    // from pulling the average luminance down and causing overexposure.
    float lum = 0;
    uint valid = 0;
    if (x < _Dims.x && y < _Dims.y) {
        float raw = get_screen_lum(x, y);
        if (raw > MIN_LUM) {
            // Clamp before log: specular highlights, sun discs, and bloom-inflated pixels
            // can have luminance 10–1000x above mid-grey. Without this clamp they pull the
            // geometric mean up even in log-space, causing the rest of the scene to underexpose.
            // _BrightnessLimit is set by the volume and mirrors _MaxBrightness in the render shader,
            // so the exposure measurement is consistent with what the render pass actually displays.
            float clamped = min(raw, _BrightnessLimit);
            
            // Log-space average: matches how the human eye perceives brightness.
            // log(L) averages stops (EV) rather than raw linear values, so a pixel at
            // luminance 0.01 and one at 1.0 average to ~0.1 instead of 0.505.
            lum = log(clamped);
            valid = 1;
        }
    }

    shared_lum[index] = lum;
    shared_pixels[index] = valid;
    GroupMemoryBarrierWithGroupSync();

    // Parallel tree reduction: GROUP_SIZE (1024) -> 1 in log2(1024) = 10 steps
    // instead of a single thread looping through everything sequentially
    [unroll]
    for (uint stride = GROUP_SIZE / 2; stride > 0; stride >>= 1) {
        if (index < stride) {
            shared_lum[index] += shared_lum[index + stride];
            shared_pixels[index] += shared_pixels[index + stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    // Thread 0 writes this group's summed log-luminance and pixel count.
    // The CPU side will compute: exp(sum_log_lum / pixel_count) = geometric mean luminance.
    if (index == 0) {
        uint groupIndex = groupId.y * _NumGroupsX + groupId.x;
        _OutBuffer[groupIndex * 2]     = shared_lum[0];
        _OutBuffer[groupIndex * 2 + 1] = (float)shared_pixels[0];
    }
}
