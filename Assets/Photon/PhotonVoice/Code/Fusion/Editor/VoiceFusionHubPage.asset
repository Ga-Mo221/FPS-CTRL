    - Text: Add Voice to the player Prefab
      Subtext: 
      WidgetMode:
        Value: Step
      AutoComplete:
        Value: None
      Hide:
        Value: None
      Scene: 
      AddSceneToTop: 0
      Icon: {fileID: 0}
      StatusIcon: {fileID: 0}
      StartPlayMode: 0
      Url: 
      Type:
        ScriptableObject: 
        Class: 
      Asset: {fileID: 0}
      Id: 97006100-31d0-4249-be0e-1721da7d730c
      StepElements:
      - Text: "To add voice chat to a NetworkObject the following components are
          needed:\r\n  - <b>Recorder</b>: Records the microphone input and sends
          it over the network.\r\n  - <b>Speaker</b>: Plays the voice audio from
          other players via the Audio Source component.\r\n  - <b>VoiceNetworkObject</b>:
          Automatically sets up the Recorder and Speaker when the NetworkObject is
          Spawned / Despawned.\r"
        Subtext: 
        WidgetMode:
          Value: Text
        AutoComplete:
          Value: None
        Hide:
          Value: None
        Scene: 
        AddSceneToTop: 0
        Icon: {fileID: 0}
        StatusIcon: {fileID: 0}
        StartPlayMode: 0
        Url: 
        Type:
          ScriptableObject: 
          Class: 
        Asset: {fileID: 0}
        Id: a375765f-4f17-47d7-aee8-bf70ee016eee
      - Text: 'The easiest way to setup is:

          > Right-click (or Ctrl+click
          on Mac) the root object of the Player prefab in the hierachy.

          >
          Select "Fusion > Voice > Add Voice to Network Object"'
        Subtext: 
        WidgetMode:
          Value: Text
        AutoComplete:
          Value: None
        Hide:
          Value: None
        Scene: 
        AddSceneToTop: 0
        Icon: {fileID: 0}
        StatusIcon: {fileID: 0}
        StartPlayMode: 0
        Url: 
        Type:
          ScriptableObject: 
          Class: 
        Asset: {fileID: 0}
        Id: a375765f-4f17-47d7-aee8-bf70ee016eee
