      isSinglePress: 1
      _readModeMigrated: 1
      overrideDeadzone: 0
  mobileSettings:
    joystickRadius: 100
    joystickDeadzone: 0.08
    dynamicJoystick: 1
    idleOpacity: 0.4
    showSkillButtons: 1
    skillButtonSize: 100
    cameraZoneWidthRatio: 0.4
    cameraZoneDebugOpacity: 0
  cameraSettings:
    mouseSensitivity: {x: 0.25, y: 0.25}
    gamepadSensitivity: {x: 180, y: 180}
    mobileSensitivity: {x: 0.12, y: 0.12}
    invertY: 0
    smoothing: 12
    pitchMin: -80
    pitchMax: 80
  gamepadSettings:
    leftStickDeadzone: 0.12
    rightStickDeadzone: 0.1
    stickCurve: 1.5
    enableRumble: 1
