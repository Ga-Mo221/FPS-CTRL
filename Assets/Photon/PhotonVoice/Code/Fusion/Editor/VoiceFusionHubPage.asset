      Id: 97006100-31d0-4249-be0e-1721da7d730c
      StepElements:
      - Text: "<b>A Voice AppId is required to connect to the Photon public cloud:</b>\r\n 
          - Open the Photon Dashboard link log in or register an account.\r\n  -
          Select an existing Voice AppId or create a new one.\r\n  - Copy the App
          Id and paste into the field below."
        Subtext: 
        WidgetMode:
          Value: Text
        AutoComplete:
          Value: None
        Hide:
          Value: None
        Scene: 
        AddSceneToTop: 0
        Icon: {fileID: 0}
