%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8c9baaa990132464c9f1066f1283ddfd, type: 3}
  m_Name: Character CTRL
  m_EditorClassIdentifier: TrueInputSystem.Runtime::TrueInputSystem.TISInputProfileConfig
  profileName: New Profile
  description: 
  enablePC: 1
  enableGamepad: 1
  enableMobile: 0
  actionMaps:
  - mapName: Movement
    enabledByDefault: 1
    actions:
    - actionName: Move
      actionType: 1
      bindingPC: <Keyboard>/wasd
      bindingPCModifier: 
      bindingGamepad: <Gamepad>/leftStick
      bindingGamepadModifier: 
      bindingMobile: TISVirtualJoystick
      readMode: 1
      isSinglePress: 0
      _readModeMigrated: 1
      overrideDeadzone: 0
    - actionName: Jump
      actionType: 0
      bindingPC: <Keyboard>/space
      bindingPCModifier: 
      bindingGamepad: <Gamepad>/buttonNorth
      bindingGamepadModifier: 
      bindingMobile: Button_1
      readMode: 0
      isSinglePress: 1
      _readModeMigrated: 1
      overrideDeadzone: 0
    - actionName: Run
      actionType: 0
      bindingPC: <Keyboard>/leftShift
      bindingPCModifier: 
      bindingGamepad: <Gamepad>/leftStickPress
      bindingGamepadModifier: 
      bindingMobile: Button_0
      readMode: 0
      isSinglePress: 1
      _readModeMigrated: 1
      overrideDeadzone: 0
    - actionName: Crouch
      actionType: 0
      bindingPC: <Keyboard>/c
      bindingPCModifier: 
      bindingGamepad: <Gamepad>/buttonSouth
      bindingGamepadModifier: 
      bindingMobile: 
      readMode: 0
      isSinglePress: 1
      _readModeMigrated: 1
      overrideDeadzone: 0
  - mapName: Camera
    enabledByDefault: 1
    actions:
    - actionName: Look
      actionType: 1
      bindingPC: <Mouse>/delta
      bindingPCModifier: 
      bindingGamepad: <Gamepad>/rightStick
      bindingGamepadModifier: 
      bindingMobile: CameraZone
      readMode: 1
      isSinglePress: 0
      _readModeMigrated: 1
      overrideDeadzone: 0
  - mapName: Skill
    enabledByDefault: 1
    actions:
    - actionName: Attack
      actionType: 0
      bindingPC: <Mouse>/leftButton
      bindingPCModifier: 
      bindingGamepad: <Gamepad>/rightTrigger
      bindingGamepadModifier: 
      bindingMobile: Button_2
      readMode: 0
      isSinglePress: 1
      _readModeMigrated: 1
      overrideDeadzone: 0
    - actionName: ADS
      actionType: 0
      bindingPC: <Mouse>/rightButton
      bindingPCModifier: 
      bindingGamepad: <Gamepad>/leftTrigger
      bindingGamepadModifier: 
      bindingMobile: Button_3
      readMode: 1
      isSinglePress: 0
      _readModeMigrated: 1
      overrideDeadzone: 0
    - actionName: Mode
      actionType: 0
      bindingPC: <Keyboard>/v
      bindingPCModifier: 
      bindingGamepad: <Gamepad>/dpad/down
      bindingGamepadModifier: 
      bindingMobile: Button_4
      readMode: 0
      isSinglePress: 1
      _readModeMigrated: 1
      overrideDeadzone: 0
    - actionName: Reload
      actionType: 0
      bindingPC: <Keyboard>/r
      bindingPCModifier: 
      bindingGamepad: <Gamepad>/buttonWest
      bindingGamepadModifier: 
      bindingMobile: 
      readMode: 0
      isSinglePress: 1
      _readModeMigrated: 1
      overrideDeadzone: 0
    - actionName: Q
      actionType: 0
      bindingPC: <Keyboard>/q
      bindingPCModifier: 
      bindingGamepad: <Gamepad>/dpad/left
      bindingGamepadModifier: 
      bindingMobile: 
      readMode: 0
      isSinglePress: 1
      _readModeMigrated: 1
      overrideDeadzone: 0
    - actionName: E
      actionType: 0
      bindingPC: <Keyboard>/e
      bindingPCModifier: 
      bindingGamepad: <Gamepad>/dpad/right
      bindingGamepadModifier: 
      bindingMobile: 
      readMode: 0
      isSinglePress: 1
      _readModeMigrated: 1
      overrideDeadzone: 0
    - actionName: Switch
      actionType: 0
      bindingPC: 
      bindingPCModifier: 
